# Endereço público do site. Deixe vazio no desenvolvimento local.
# Produção: PUBLIC_URL=https://arrivoinitalia.com
PUBLIC_URL=

# Use 1 quando a aplicação estiver atrás de um proxy reverso (Traefik/Nginx) na VPS,
# para que o limite de tentativas de login use o IP real do visitante.
TRUST_PROXY=0

# Stripe (mesma conta/CNPJ do ArremataFlow). Sem a chave, a página de vendas mostra "vendas em breve".
# Webhook: cadastre https://arrivoinitalia.com/api/stripe/webhook com os eventos
# checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, checkout.session.expired e charge.refunded.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
